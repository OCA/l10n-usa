<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- View account.tax form -->
    <record id="view_account_tax_form" model="ir.ui.view">
        <field name="name">view.account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="before">
                <page
                    string="Bill.com"
                    name="billcom_info"
                    attrs="{'invisible': [('billcom_item_id', '==', False)]}"
                >
                    <group>
                        <field name="billcom_item_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
