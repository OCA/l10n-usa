#. module: l10n_us_sales_tax_engine_origin_sourcing
#: model_terms:ir.ui.view,arch_db:l10n_us_sales_tax_engine_origin_sourcing.res_config_settings_view_us_tax
msgid ""
"Address used by default on new sales orders and customer invoices: the "
"customer's delivery address (destination) or the company's (origin). It can "
"be changed on each draft document."
msgstr ""

#. module: l10n_us_sales_tax_engine_origin_sourcing
