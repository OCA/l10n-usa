<odoo>
    <!-- Each company sees only its own tax authorities (mirrors the engine's
         nexus/calculation-log multi-company rules). -->
    <record id="rule_us_tax_authority_company" model="ir.rule">
        <field name="name">US Tax Authority: Multi-Company</field>
        <field name="model_id" ref="model_us_tax_authority" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True" />
    </record>
</odoo>
