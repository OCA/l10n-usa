<odoo>
    <record id="view_us_tax_exemption_reason_list" model="ir.ui.view">
        <field name="name">us.tax.exemption.reason.list</field>
        <field name="model">us.tax.exemption.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="code" />
                <field name="ser_breakout" />
                <field name="entity_use_code" />
            </list>
        </field>
    </record>

    <record id="action_us_tax_exemption_reason" model="ir.actions.act_window">
        <field name="name">Exemption Reasons</field>
        <field name="res_model">us.tax.exemption.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
