<odoo>
    <record id="view_us_tax_rule_import_wizard_form" model="ir.ui.view">
        <field name="name">us.tax.rule.import.wizard.form</field>
        <field name="model">us.tax.rule.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Taxability Matrix">
                <p>
                    Upload a per-state CSV mapping the SST Taxability Matrix onto
                    product categories. Header columns:
                    <code>category_code, taxable, rate_override, effective_date,
                    end_date</code>. A future <b>effective_date</b> schedules the
                    change; it activates automatically on that date and supersedes
                    the prior rule.
                </p>
                <group>
                    <field name="state_id" />
                    <field name="matrix_file" filename="matrix_filename" />
                    <field name="matrix_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_us_tax_rule_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Taxability Matrix</field>
        <field name="res_model">us.tax.rule.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
