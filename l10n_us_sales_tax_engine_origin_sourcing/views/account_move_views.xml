<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_move_us_tax" model="ir.ui.view">
        <field name="name">account.move.us.tax.origin.sourcing.form</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_us_sales_tax_engine.view_account_move_us_tax"
        />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not us_tax_origin_out_of_state or state != 'draft'"
                >
                    US sales tax is computed with the company address, and the
                    delivery address is in another state. If you prefer to compute
                    it with the delivery address, uncheck
                    <strong>Tax Based on Company Address</strong>.
                </div>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not us_tax_origin_address_missing or state != 'draft'"
                >
                    <strong>Tax Based on Company Address</strong> is checked, but
                    the company has no 5-digit ZIP, state and United States as
                    country: US sales tax is computed with the customer address.
                </div>
            </xpath>
            <xpath expr="//field[@name='us_tax_source']" position="before">
                <field
                    name="us_tax_based_on_company"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state != 'draft'"
                />
            </xpath>
        </field>
    </record>
</odoo>
