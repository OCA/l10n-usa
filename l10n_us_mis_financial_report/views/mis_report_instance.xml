<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="mis_report_instance_view_form_inherit">
        <field
            name="name"
        >l10n_us_mis_financial_report.mis.report.instance.view.form.inherit
        </field>
        <field name="model">mis.report.instance</field>
        <field name="inherit_id" ref="mis_builder.mis_report_instance_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='filters']//field[@name='target_move']"
                position="after"
            >
                <field name="hide_all_lines_0" widget="boolean_toggle" />
                <field name="journal_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>
</odoo>
