<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_jurisdiction_list" model="ir.ui.view">
        <field name="name">us.tax.jurisdiction.list</field>
        <field name="model">us.tax.jurisdiction</field>
        <field name="arch" type="xml">
            <list string="Jurisdictions" decoration-muted="not active">
                <field name="complete_name" />
                <field name="type" />
                <field name="state_id" />
                <field name="county" />
                <field name="city" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="view_us_tax_jurisdiction_form" model="ir.ui.view">
        <field name="name">us.tax.jurisdiction.form</field>
        <field name="model">us.tax.jurisdiction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="complete_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="type" />
                            <field name="state_id" />
                            <field name="parent_id" />
                        </group>
                        <group>
                            <field name="county" />
                            <field name="city" />
                            <field name="district_code" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_us_tax_jurisdiction_search" model="ir.ui.view">
        <field name="name">us.tax.jurisdiction.search</field>
        <field name="model">us.tax.jurisdiction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state_id" />
                <field name="county" />
                <filter name="state" string="States" domain="[('type','=','state')]" />
                <filter
                    name="county"
                    string="Counties"
                    domain="[('type','=','county')]"
                />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="by_state"
                        string="State"
                        context="{'group_by': 'state_id'}"
                    />
                    <filter
                        name="by_type"
                        string="Type"
                        context="{'group_by': 'type'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_us_tax_jurisdiction" model="ir.actions.act_window">
        <field name="name">Jurisdictions</field>
        <field name="res_model">us.tax.jurisdiction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state': 1}</field>
    </record>
</odoo>
