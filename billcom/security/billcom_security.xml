<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Security Groups -->
        <record model="ir.module.category" id="module_category_billcom">
            <field name="name">Bill.com</field>
            <field name="sequence">16</field>
        </record>

        <record id="group_billcom_user" model="res.groups">
            <field name="name">Bill.com User</field>
            <field name="category_id" ref="billcom.module_category_billcom" />
            <field
            name="comment"
        >Can create and sync bills to Bill.com. Cannot approve bills or manage payments.</field>
            <field
            name="implied_ids"
            eval="[(4, ref('account.group_account_invoice'))]"
        />
        </record>

        <record id="group_billcom_approver" model="res.groups">
            <field name="name">Bill.com Approver</field>
            <field name="category_id" ref="billcom.module_category_billcom" />
            <field
            name="comment"
        >Can approve/post bills. Cannot create or sync payments.</field>
            <field name="implied_ids" eval="[(4, ref('group_billcom_user'))]" />
        </record>

        <record id="group_billcom_payment_manager" model="res.groups">
            <field name="name">Bill.com Payment Manager</field>
            <field name="category_id" ref="billcom.module_category_billcom" />
            <field
            name="comment"
        >Full access: Can approve bills, create payments, and sync payments to Bill.com.</field>
            <field name="implied_ids" eval="[(4, ref('group_billcom_approver'))]" />
        </record>

        <!-- Record Rules -->
        <record id="rule_billcom_config" model="ir.rule">
            <field name="name">Bill.com Configuration: Account User</field>
            <field name="model_id" ref="billcom.model_billcom_config" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_billcom_config_manager" model="ir.rule">
            <field name="name">Bill.com Configuration: Account Manager</field>
            <field name="model_id" ref="billcom.model_billcom_config" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <record id="rule_billcom_service" model="ir.rule">
            <field name="name">Bill.com Service: Account User</field>
            <field name="model_id" ref="billcom.model_billcom_service" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_billcom_service_manager" model="ir.rule">
            <field name="name">Bill.com Service: Account Manager</field>
            <field name="model_id" ref="billcom.model_billcom_service" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <!-- Bill.com Role-Based Record Rules -->

        <!-- Payments: Only Payment Manager can create/write payments -->
        <record id="rule_account_payment_billcom_user_readonly" model="ir.rule">
            <field name="name">Payments: Bill.com User (Read Only)</field>
            <field name="model_id" ref="account.model_account_payment" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_billcom_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_account_payment_billcom_approver_readonly" model="ir.rule">
            <field name="name">Payments: Bill.com Approver (Read Only)</field>
            <field name="model_id" ref="account.model_account_payment" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_billcom_approver'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="rule_account_payment_billcom_payment_manager" model="ir.rule">
            <field name="name">Payments: Bill.com Payment Manager (Full Access)</field>
            <field name="model_id" ref="account.model_account_payment" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_billcom_payment_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
        </record>

</odoo>
