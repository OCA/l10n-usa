<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_rule_list" model="ir.ui.view">
        <field name="name">us.tax.rule.list</field>
        <field name="model">us.tax.rule</field>
        <field name="arch" type="xml">
            <list string="Tax Rules">
                <field name="state_id" />
                <field name="product_tax_category_id" />
                <field name="taxable" />
                <field name="rate_override" optional="show" />
                <field name="effective_date" optional="show" />
                <field name="end_date" optional="show" />
                <field name="active" optional="show" />
            </list>
        </field>
    </record>
    <record id="view_us_tax_rule_form" model="ir.ui.view">
        <field name="name">us.tax.rule.form</field>
        <field name="model">us.tax.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Applicability">
                            <field name="state_id" />
                            <field name="product_tax_category_id" />
                        </group>
                        <group string="Rule">
                            <field name="taxable" />
                            <field name="rate_override" invisible="taxable" />
                            <field name="exemption_reason" invisible="taxable" />
                        </group>
                        <group string="Validity">
                            <field name="effective_date" />
                            <field name="end_date" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_us_tax_rule" model="ir.actions.act_window">
        <field name="name">Tax Rules</field>
        <field name="res_model">us.tax.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
