<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Scheduled Action for Bill.com Full Synchronization -->
        <record id="ir_cron_sync_billcom" model="ir.cron">
            <field name="name">Bill.com: Full Synchronization</field>
            <field name="model_id" ref="model_billcom_service" />
            <field name="state">code</field>
            <field name="code">
model.full_sync_billcom()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
        </record>

        <!-- Scheduled Action for Bill.com Payment Synchronization -->
        <record id="ir_cron_sync_billcom_payments" model="ir.cron">
            <field name="name">Bill.com: Payment Synchronization</field>
            <field name="model_id" ref="model_billcom_service" />
            <field name="state">code</field>
            <field name="code">
model.sync_billcom_payments()
            </field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
        </record>

        <!-- Scheduled Action for Bill.com Payment Status Updates -->
        <record id="ir_cron_update_payment_status" model="ir.cron">
            <field name="name">Bill.com: Update Payment Status</field>
            <field name="model_id" ref="model_account_payment" />
            <field name="state">code</field>
            <field name="code">
model.update_billcom_payment_status_cron()
            </field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
        </record>
</odoo>
