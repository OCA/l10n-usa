<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add Calculate US Tax button + Tax Source field to Sale Order -->
    <record id="view_sale_order_us_tax" model="ir.ui.view">
        <field name="name">sale.order.us.tax.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- Add button next to Send by Email -->
            <xpath expr="//button[@name='action_quotation_send']" position="before">
                <button
                    name="action_calculate_us_tax"
                    type="object"
                    string="Calculate US Tax"
                    class="btn-secondary"
                    invisible="not us_tax_engine_available or state not in ('draft', 'sent', 'sale') or locked or invoice_status in ('invoiced', 'upselling')"
                    title="Calculate US Sales Tax based on customer shipping address"
                />
            </xpath>
            <!-- Outdated tax warning, in the alert stack above the sheet -->
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not us_tax_is_stale or not us_tax_engine_available"
                >
                    <span
                    >The US Sales Tax inputs changed after the last calculation. The tax shown on this order is outdated.</span>
                    <button
                        name="action_calculate_us_tax"
                        type="object"
                        string="Recalculate US Tax"
                        class="btn-link"
                        invisible="not us_tax_engine_available or state not in ('draft', 'sent', 'sale') or locked or invoice_status in ('invoiced', 'upselling')"
                    />
                </div>
            </xpath>
            <!-- Add Tax Source info + shipping toggle below payment terms -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="us_tax_engine_available" invisible="1" />
                <field name="us_tax_is_stale" invisible="1" />
                <field
                    name="us_tax_based_on_shipping"
                    string="Tax Based on Shipping Address"
                />
                <field
                    name="us_tax_source"
                    string="Tax Source"
                    readonly="1"
                    invisible="not us_tax_source"
                />
                <field
                    name="us_tax_calculated_at"
                    string="Tax Calculated"
                    readonly="1"
                    invisible="not us_tax_calculated_at"
                />
            </xpath>
        </field>
    </record>

    <!-- Add US Tax info to Sale Order list view -->
    <record id="view_sale_order_us_tax_list" model="ir.ui.view">
        <field name="name">sale.order.us.tax.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="us_tax_source" string="Tax Source" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
