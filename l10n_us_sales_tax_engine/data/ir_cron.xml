<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="cron_purge_tax_cache" model="ir.cron">
        <field name="name">US Tax: Purge Expired Cache</field>
        <field name="model_id" ref="model_us_tax_api_cache" />
        <field name="state">code</field>
        <field name="code">model.purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>

    <record id="cron_reset_provider_counters" model="ir.cron">
        <field name="name">US Tax: Reset Monthly API Call Counters</field>
        <field name="model_id" ref="model_us_tax_provider" />
        <field name="state">code</field>
        <field name="code">model.search([]).action_reset_monthly_counter()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>

    <!-- One record per document model: ir.cron._callback rolls back the whole
         job on failure, so a single cron would let a sale.order error discard
         the account.move work already done in the same run. A downstream addon
         adds a third document type by shipping its own record here. -->
    <record id="ir_cron_recalculate_outdated_us_tax_sale_order" model="ir.cron">
        <field name="name">US Tax: Recalculate Outdated Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="state">code</field>
        <field name="code">model._us_tax_cron_recalculate_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>

    <record id="ir_cron_recalculate_outdated_us_tax_account_move" model="ir.cron">
        <field name="name">US Tax: Recalculate Outdated Invoices</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">model._us_tax_cron_recalculate_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
