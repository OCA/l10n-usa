<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_import_batch_list" model="ir.ui.view">
        <field name="name">us.tax.import.batch.list</field>
        <field name="model">us.tax.import.batch</field>
        <field name="arch" type="xml">
            <list
                string="Import History"
                decoration-danger="status == 'failed'"
                decoration-success="status == 'done'"
                decoration-muted="status == 'pending'"
            >
                <field name="name" />
                <field name="source" />
                <field name="state_id" />
                <field name="effective_date" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'done'"
                    decoration-warning="status == 'running'"
                    decoration-danger="status == 'failed'"
                />
                <field name="records_created" string="Created" />
                <field name="records_updated" string="Updated" />
                <field name="started_at" optional="show" />
            </list>
        </field>
    </record>
    <record id="view_us_tax_import_batch_form" model="ir.ui.view">
        <field name="name">us.tax.import.batch.form</field>
        <field name="model">us.tax.import.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Import">
                            <field name="source" />
                            <field name="file_name" />
                            <field name="state_id" />
                            <field name="effective_date" />
                            <field name="status" widget="badge" />
                        </group>
                        <group string="Results">
                            <field name="records_created" />
                            <field name="records_updated" />
                            <field name="records_skipped" />
                            <field name="started_at" />
                            <field name="finished_at" />
                        </group>
                    </group>
                    <field
                        name="error_log"
                        readonly="1"
                        invisible="not error_log"
                        widget="text"
                    />
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_us_tax_import_batch" model="ir.actions.act_window">
        <field name="name">Import History</field>
        <field name="res_model">us.tax.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_done': 0}</field>
    </record>
</odoo>
