<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_rate_list" model="ir.ui.view">
        <field name="name">us.tax.rate.list</field>
        <field name="model">us.tax.rate</field>
        <field name="arch" type="xml">
            <list string="Tax Rates" decoration-muted="not active">
                <field name="jurisdiction_id" />
                <field name="state_id" />
                <field name="product_tax_category_id" />
                <field name="state_rate" string="State %" />
                <field name="county_rate" string="County %" />
                <field name="city_rate" string="City %" />
                <field name="total_rate" string="Total %" />
                <field name="effective_date" />
                <field name="end_date" />
                <field name="source" />
            </list>
        </field>
    </record>
    <record id="view_us_tax_rate_form" model="ir.ui.view">
        <field name="name">us.tax.rate.form</field>
        <field name="model">us.tax.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Jurisdiction">
                            <field name="jurisdiction_id" />
                            <field name="state_id" readonly="1" />
                            <field name="product_tax_category_id" />
                        </group>
                        <group string="Rates">
                            <field name="state_rate" widget="percentage" />
                            <field name="county_rate" widget="percentage" />
                            <field name="city_rate" widget="percentage" />
                            <field name="district_rate" widget="percentage" />
                            <field name="total_rate" widget="percentage" readonly="1" />
                        </group>
                        <group string="Validity">
                            <field name="effective_date" />
                            <field name="end_date" />
                            <field name="active" />
                        </group>
                        <group string="Source">
                            <field name="source" />
                            <field name="source_url" widget="url" />
                            <field name="import_batch_id" />
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..." />
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_us_tax_rate" model="ir.actions.act_window">
        <field name="name">Tax Rates</field>
        <field name="res_model">us.tax.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
