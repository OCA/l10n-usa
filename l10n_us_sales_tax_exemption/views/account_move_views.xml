<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_us_tax_exemption" model="ir.ui.view">
        <field name="name">account.move.form.us.tax.exemption</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Snapshot scalars only. us_tax_exemption_id stays off the form:
                 reading it needs the US-tax groups, which an accountant
                 reviewing the invoice may not hold. -->
            <field name="invoice_payment_term_id" position="after">
                <field
                    name="us_tax_exemption_reason"
                    invisible="not us_tax_exemption_reason"
                />
                <field
                    name="us_tax_exemption_number"
                    invisible="not us_tax_exemption_number"
                />
            </field>
        </field>
    </record>
</odoo>
