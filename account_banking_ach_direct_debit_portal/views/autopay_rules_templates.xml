<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_autopay_rules">
        <t t-call="portal.portal_layout">
            <t t-set="page_title" t-value="'Autopay Rules'" />
            <t t-set="additional_title"><t t-esc="page_title" /></t>
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <div class="d-none d-md-block">
                <t
                    t-call="account_banking_ach_direct_debit_portal.debit_portal_searchbar"
                >
                    <t t-set="title">Autopay Rules</t>

                    <a href="/my/banks" class="btn btn-secondary">
                        Manage bank accounts
                    </a>
                </t>
            </div>

            <div id="autopay-settings" class="mt-3 mt-lg-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="left-header">
                        <h4 class="header-title mb-0 me-2">Autopay Rules</h4>

                        <div class="d-md-none mt-2">
                            <a href="/my/banks" class="btn btn-secondary">
                                Manage bank accounts
                            </a>
                        </div>

                        <div class="text-danger mt-sm-1">
                            <i
                                class="fa fa-exclamation-circle me-1"
                            /> Bank authentication is required
                        </div>
                    </div>

                    <div
                        t-if="bank_account_total > 0"
                        class="d-flex justify-content-end align-items-center mt-2 mt-md-0"
                    >
                        <label class="btn btn-toggle">
                            Enable Autopay
                            <input
                                class="autopay-disable"
                                name="autopay_rule"
                                id="rule_disabled"
                                value="disabled"
                                t-att-checked="partner.autopay != 'disabled'"
                                type="checkbox"
                            />
                            <span class="slider" />
                        </label>
                    </div>
                </div>

                <t t-if="not bank_account_total">
                    <p>
                        Please add a bank account first.
                    </p>
                </t>

                <div
                    t-if="updated_autopay_rules"
                    class="alert alert-success"
                    role="alert"
                >
                    Your changes have been saved.
                </div>

                <t t-if="bank_account_total > 0 and partner.autopay != 'disabled'">
                    <form method="post" action="/autopay-rules">
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />

                        <label class="rule-option" for="rule_1">
                            <div
                                class="d-flex justify-content-between align-items-center cursor-pointer w-100"
                            >
                                <div
                                    class="d-flex justify-content-start align-items-center"
                                >
                                    <input
                                        type="radio"
                                        class="autopay-radio"
                                        name="autopay_rule"
                                        id="rule_1"
                                        value="end_of_month"
                                        t-att-checked="'end_of_month' == partner.autopay"
                                    />
                                    <span
                                        class="ms-2"
                                    >Number of days before month end</span>
                                </div>

                                <span
                                    class="note text-muted"
                                >5 days before month end ( Default )</span>
                            </div>
                        </label>

                        <label class="rule-option" for="rule_2">
                            <div
                                class="d-flex justify-content-between align-items-center cursor-pointer w-100"
                            >
                                <div
                                    class="d-flex justify-content-start align-items-center"
                                >
                                    <input
                                        type="radio"
                                        class="autopay-radio"
                                        name="autopay_rule"
                                        id="rule_2"
                                        value="on_due_date"
                                        t-att-checked="'on_due_date' == partner.autopay"
                                    />
                                    <span class="ms-2">On due date</span>
                                </div>

                                <span class="note text-muted">Current date: <t
                                        t-esc="current_date"
                                    /></span>
                            </div>
                        </label>

                        <div
                            class="d-flex justify-content-end align-items-center w-100"
                        >
                            <button type="submit" class="btn btn-blue">Save</button>
                        </div>
                    </form>
                </t>
            </div>

            <t t-call-assets="web.account_banking_ach_direct_debit_portal" />
        </t>
    </template>
</odoo>
