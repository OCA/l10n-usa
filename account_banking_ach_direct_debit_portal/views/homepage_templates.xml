<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_home">
        <t t-call="portal.portal_layout">
            <t t-set="page_title" t-value="'My Account'" />
            <t t-set="additional_title"><t t-esc="page_title" /></t>
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <div id="account-homepage" class="mt-3">
                <div class="header mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="header-title me-2">Invoices</h2>

                        <a
                            t-if="not invisible_button"
                            href="/my/settings"
                            class="setting-icon"
                        >
                            <i class="fa fa-cog" aria-hidden="true" />
                        </a>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4 col-sm-12">
                        <div class="card-credit">
                            <div
                                class="d-flex justify-content-start align-items-center mb-2"
                            >
                                <i class="icon fa fa-money" />
                                <div class="title ms-2">Upcoming auto payments</div>
                            </div>
                            <div class="amount">
                                <span
                                    t-esc="upcoming_autopay_amount"
                                    t-options='{"widget": "monetary", "display_currency": display_currency}'
                                />
                            </div>
                            <div
                                class="d-flex justify-content-between align-items-center mb-2"
                            >
                                <div
                                    t-if="next_autopay_date"
                                    class="text-muted mt-1"
                                >on <t
                                        t-esc="next_autopay_date.strftime('%-m/%-d/%y')"
                                    /></div>
                                <a
                                    t-if="not invisible_button"
                                    href="/autopay-rules"
                                    class="blue-title text-decoration-underline"
                                >Autopay settings</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-12">
                        <div class="card-credit">
                            <div
                                class="d-flex justify-content-start align-items-center mb-2"
                            >
                                <i class="icon fa fa-credit-card" />
                                <div class="title ms-2">Amount due</div>
                            </div>
                            <div class="amount">
                                <span
                                    t-esc="amount_due"
                                    t-options='{"widget": "monetary", "display_currency": display_currency}'
                                />
                            </div>
                            <div t-if="max_due_date" class="text-muted mt-1">Due on <t
                                    t-esc="max_due_date.strftime('%-m/%-d/%y')"
                                /></div>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-12">
                        <div class="card-credit">
                            <div
                                class="d-flex justify-content-start align-items-center mb-2"
                            >
                                <i class="icon fa fa-university" />
                                <div class="title ms-2">Available credit</div>
                            </div>
                            <div class="amount">
                                <span
                                    t-esc="available_credit"
                                    t-options='{"widget": "monetary", "display_currency": display_currency}'
                                />
                            </div>
                            <div class="text-muted mt-1">
                                of
                                <span
                                    t-esc="credit_limit"
                                    t-options='{"widget": "monetary", "display_currency": display_currency}'
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="filter-panel d-flex justify-content-end mt-3">
                    <div class="search-box me-2">
                        <form action="/my/payment-account" method="get" role="search">
                            <input
                                type="text"
                                name="search"
                                t-att-value="invoice_search or ''"
                                class="form-control"
                                placeholder="Search Invoices"
                                aria-label="Search Invoices"
                            />

                            <button type="submit">
                                <i class="fa fa-search" />
                            </button>
                        </form>
                    </div>

                    <div t-if="invoice_searchbar_sortings" class="filter-item me-2">
                        <span class="fs-16 text-gray me-1">Filter By:</span>
                        <div class="btn-group">
                            <button
                                id="portal_searchbar_sortby"
                                data-bs-toggle="dropdown"
                                class="btn btn-secondary dropdown-toggle"
                            >
                                <t
                                    t-esc="invoice_searchbar_sortings[invoice_sortby].get('label', 'Newest')"
                                />
                            </button>
                            <div
                                class="dropdown-menu"
                                aria-labelledby="portal_searchbar_sortby"
                            >
                                <t t-foreach="invoice_searchbar_sortings" t-as="option">
                                    <a
                                        t-att-href="request.httprequest.path + '?' + keep_query('*', invoice_sortby=option)"
                                        t-attf-class="dropdown-item#{invoice_sortby == option and ' active' or ''}"
                                    >
                                        <span
                                            t-esc="invoice_searchbar_sortings[option].get('label')"
                                        />
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div t-if="invoice_status_filters" class="filter-item me-2">
                        <span class="fs-16 text-gray me-1">Status:</span>
                        <div class="btn-group">
                            <button
                                id="invoice_status_filter"
                                data-bs-toggle="dropdown"
                                class="btn btn-secondary dropdown-toggle"
                            >
                                <t
                                    t-esc="invoice_status_filters[invoice_status].get('label', 'All')"
                                />
                            </button>
                            <div
                                class="dropdown-menu"
                                aria-labelledby="invoice_status_filter"
                            >
                                <t t-foreach="invoice_status_filters" t-as="option">
                                    <a
                                        t-att-href="request.httprequest.path + '?' + keep_query('*', invoice_status=option)"
                                        t-attf-class="dropdown-item#{invoice_status == option and ' active' or ''}"
                                    >
                                        <span
                                            t-esc="invoice_status_filters[option].get('label')"
                                        />
                                    </a>
                                </t>
                            </div>
                        </div>
                    </div>

                    <a
                        class="btn btn-blue pay-btn rounded-5 d-none"
                        href="javascript:void(0);"
                    >
                        Pay selected
                    </a>
                </div>

                <!-- Table desktop/tablet -->
                <div class="table-responsive d-none d-md-block border-0 mt-4">
                    <table class="table mb-0 bg-white o_portal_my_doc_table">
                        <thead class="thead-light">
                            <tr>
                                <th>
                                    <input type="checkbox" />
                                </th>
                                <th>Status</th>
                                <th>Invoice #</th>
                                <th>Due Date</th>
                                <th>Amount Due</th>
                                <th>Issue Date</th>
                                <th />
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="invoice">
                                <tr>
                                    <td>
                                        <input
                                            type="checkbox"
                                            name="invoice_ids"
                                            class="invoice-checkbox"
                                            t-att-value="invoice.id"
                                            t-att-disabled="'disabled' if invoice.payment_state == 'paid' else None"
                                        />
                                    </td>
                                    <td class="tx_status">
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state not in ('in_payment', 'paid', 'reversed')"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-warning"
                                            >
                                                <i
                                                    class="fa fa-fw fa-clock-o"
                                                    aria-label="Opened"
                                                    title="Opened"
                                                    role="img"
                                                />
                                                <span
                                                    class="d-none d-md-inline"
                                                > Awaiting payment</span>
                                            </span>
                                        </t>
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state in ('paid', 'in_payment')"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-success"
                                            >
                                                <i
                                                    class="fa fa-fw fa-check"
                                                    aria-label="Paid"
                                                    title="Paid"
                                                    role="img"
                                                />
                                                <span
                                                    class="d-none d-md-inline"
                                                > Paid</span>
                                            </span>
                                        </t>
                                        <t
                                            t-if="invoice.state == 'posted' and invoice.payment_state == 'reversed'"
                                        >
                                            <span
                                                class="badge rounded-pill text-bg-success"
                                            >
                                                <i
                                                    class="fa fa-fw fa-check"
                                                    aria-label="Reversed"
                                                    title="Reversed"
                                                    role="img"
                                                />
                                                <span
                                                    class="d-none d-md-inline"
                                                > Reversed</span>
                                            </span>
                                        </t>
                                        <t t-if="invoice.state == 'cancel'">
                                            <span
                                                class="badge rounded-pill text-bg-danger"
                                            >
                                                <i
                                                    class="fa fa-fw fa-remove"
                                                    aria-label="Cancelled"
                                                    title="Cancelled"
                                                    role="img"
                                                />
                                                <span
                                                    class="d-none d-md-inline"
                                                > Cancelled</span>
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <a
                                            t-att-href="invoice.get_portal_url()"
                                            t-att-title="invoice.name"
                                            class="blue-title text-decoration-underline"
                                        >
                                            <span t-field="invoice.name" />
                                        </a>
                                    </td>
                                    <td>
                                        <t
                                            t-if="'ago' in invoice_due_status_values[invoice.id].lower() and invoice.payment_state != 'paid'"
                                        >
                                            <div class="text-danger">
                                                <t
                                                    t-esc="invoice_due_status_values[invoice.id]"
                                                />
                                            </div>
                                        </t>
                                        <t t-elif="invoice.payment_state == 'paid'">
                                            <div class="text-muted">
                                                <t
                                                    t-esc="invoice_due_status_values[invoice.id]"
                                                />
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div>
                                                <t
                                                    t-esc="invoice_due_status_values[invoice.id]"
                                                />
                                            </div>
                                        </t>
                                        <div class="text-muted fs-12">(<t
                                                t-esc="invoice.invoice_date_due.strftime('%-m/%-d/%y')"
                                            />)</div>
                                    </td>
                                    <td>
                                        <span
                                            t-esc="-invoice.amount_residual if invoice.move_type == 'out_refund' else invoice.amount_residual"
                                            t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'
                                        />
                                    </td>
                                    <td>
                                        <span
                                            t-esc="invoice.invoice_date.strftime('%-m/%-d/%y')"
                                        />
                                    </td>
                                    <td>
                                        <a
                                            t-if="invoice.state == 'posted' and invoice.payment_state not in ('paid', 'in_payment')"
                                            t-attf-href="/select-payment-method?invoice=#{invoice.id}"
                                            class="btn btn-blue rounded-5"
                                        >
                                            Pay
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Table mobile -->
                <div class="table-responsive d-md-none border rounded px-3 py-2 mt-2">
                    <table class="table o_portal_my_doc_table align-middle mb-0">
                        <tbody>
                            <t t-foreach="invoices" t-as="invoice">
                                <tr class="invoice-row">
                                    <td>
                                        <div class="label">Status</div>
                                        <div class="tx_status">
                                            <t
                                                t-if="invoice.state == 'posted' and invoice.payment_state not in ('in_payment', 'paid', 'reversed')"
                                            >
                                                <span
                                                    class="badge rounded-pill text-bg-warning"
                                                >
                                                    <i
                                                        class="fa fa-fw fa-clock-o"
                                                        aria-label="Opened"
                                                        title="Opened"
                                                        role="img"
                                                    />
                                                    <span
                                                        class="d-none d-md-inline"
                                                    > Awaiting
                                                        Payment</span>
                                                </span>
                                            </t>
                                            <t
                                                t-if="invoice.state == 'posted' and invoice.payment_state in ('paid', 'in_payment')"
                                            >
                                                <span
                                                    class="badge rounded-pill text-bg-success"
                                                >
                                                    <i
                                                        class="fa fa-fw fa-check"
                                                        aria-label="Paid"
                                                        title="Paid"
                                                        role="img"
                                                    />
                                                    <span
                                                        class="d-none d-md-inline"
                                                    > Paid</span>
                                                </span>
                                            </t>
                                            <t
                                                t-if="invoice.state == 'posted' and invoice.payment_state == 'reversed'"
                                            >
                                                <span
                                                    class="badge rounded-pill text-bg-success"
                                                >
                                                    <i
                                                        class="fa fa-fw fa-check"
                                                        aria-label="Reversed"
                                                        title="Reversed"
                                                        role="img"
                                                    />
                                                    <span
                                                        class="d-none d-md-inline"
                                                    > Reversed</span>
                                                </span>
                                            </t>
                                            <t t-if="invoice.state == 'cancel'">
                                                <span
                                                    class="badge rounded-pill text-bg-danger"
                                                >
                                                    <i
                                                        class="fa fa-fw fa-remove"
                                                        aria-label="Cancelled"
                                                        title="Cancelled"
                                                        role="img"
                                                    />
                                                    <span
                                                        class="d-none d-md-inline"
                                                    > Cancelled</span>
                                                </span>
                                            </t>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="label">Invoice #</div>
                                        <div class="value">
                                            <a
                                                t-att-href="invoice.get_portal_url()"
                                                t-att-title="invoice.name"
                                                class="blue-title text-decoration-underline"
                                            >
                                                <span t-field="invoice.name" />
                                            </a>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="label">Due Date</div>
                                        <div class="value">
                                            <t
                                                t-if="'ago' in invoice_due_status_values[invoice.id].lower() and invoice.payment_state != 'paid'"
                                            >
                                                <div class="text-danger">
                                                    <t
                                                        t-esc="invoice_due_status_values[invoice.id]"
                                                    />
                                                </div>
                                            </t>
                                            <t t-elif="invoice.payment_state == 'paid'">
                                                <div class="text-muted">
                                                    <t
                                                        t-esc="invoice_due_status_values[invoice.id]"
                                                    />
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div>
                                                    <t
                                                        t-esc="invoice_due_status_values[invoice.id]"
                                                    />
                                                </div>
                                            </t>
                                            <div class="text-muted fs-12">(<t
                                                    t-esc="invoice.invoice_date_due.strftime('%-m/%-d/%y')"
                                                />)</div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="label">Amount Due</div>
                                        <div class="value">
                                            <span
                                                t-esc="-invoice.amount_residual if invoice.move_type == 'out_refund' else invoice.amount_residual"
                                                t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'
                                            />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="label">Issue Date</div>
                                        <div class="value">
                                            <span
                                                t-esc="invoice.invoice_date.strftime('%-m/%-d/%y')"
                                            />
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        <a
                                            t-if="invoice.state == 'posted' and invoice.payment_state not in ('paid', 'in_payment')"
                                            t-attf-href="/select-payment-method?invoice=#{invoice.id}"
                                            class="btn btn-blue rounded-5"
                                        >
                                            Pay
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div
                    class="d-flex justify-content-end align-items-center mt-3"
                    style="padding-right: 12px;"
                >
                    <a
                        href="/my/invoices"
                        class="blue-title text-decoration-underline"
                    >View all</a>
                </div>

                <t t-if="payment_successful">
                    <div class="modal fade" id="modal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content p-3 p-md-4">
                            <div class="modal-body text-center">
                                <div class="mb-3">
                                    <i
                                            class="fa fa-check-circle blue-title"
                                            style="font-size: 4rem;"
                                        />
                                </div>
                                <h1 class="blue-title mb-2">Thank you!</h1>
                                <h3
                                        class="text-gray mb-3"
                                    >Your payment has been processed.</h3>
                                <p class="text-gray fs-16 mb-4">
                                    A payment receipt has been sent to your email.<br />
                                    If you have any questions, contact our support team at <strong
                                        >1-800-KENCOVE</strong>.
                                </p>
                                <button
                                        type="button"
                                        class="btn btn-blue"
                                        data-bs-dismiss="modal"
                                    >
                                    Return to Invoices
                                </button>
                            </div>
                            </div>
                        </div>
                    </div>

                    <a
                        data-bs-toggle="modal"
                        data-bs-target="#modal"
                        id="autoTrigger"
                        hidden="true"
                    />

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            document.getElementById("autoTrigger").click();
                        });
                    </script>
                </t>

                <t t-if="payment_failed">
                    <div class="modal fade" id="modal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content p-3 p-md-4">
                            <div class="modal-body text-center">
                                <div class="mb-3">
                                    <i
                                            class="fa fa-exclamation-circle text-danger"
                                            style="font-size: 4rem;"
                                        />
                                </div>
                                <h1 class="blue-title mb-2">Something went wrong.</h1>
                                <h3
                                        class="text-gray mb-3"
                                    >Your payment could not be processed.</h3>
                                <p class="text-gray fs-16 mb-4">
                                    Please contact our support team at <strong
                                        >1-800-KENCOVE</strong>.<br />
                                    Have your invoice number ready.
                                </p>
                                <button
                                        type="button"
                                        class="btn btn-blue"
                                        data-bs-dismiss="modal"
                                    >
                                    Return to Invoices
                                </button>
                            </div>
                            </div>
                        </div>
                    </div>

                    <a
                        data-bs-toggle="modal"
                        data-bs-target="#modal"
                        id="autoTrigger"
                        hidden="true"
                    />

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            document.getElementById("autoTrigger").click();
                        });
                    </script>
                </t>
            </div>

            <t t-call-assets="web.account_banking_ach_direct_debit_portal" />
        </t>
    </template>
</odoo>
