<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_us_tax_api_ninjas" model="ir.ui.view">
        <field name="name">res.config.settings.us.tax.api.ninjas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='us_tax_providers_block']" position="inside">
                <setting
                    id="us_tax_api_ninjas_setting"
                    invisible="not us_tax_engine_active or us_tax_engine_mode == 'local'"
                    help="Free tier returns state rate only. Register at api-ninjas.com"
                >
                    <field name="us_tax_enable_api_ninjas" string="Enable API Ninjas" />
                    <div invisible="not us_tax_enable_api_ninjas" class="mt8">
                        <label for="us_tax_api_ninjas_key" string="API Ninjas Key" />
                        <field
                            name="us_tax_api_ninjas_key"
                            password="True"
                            placeholder="X-Api-Key from api-ninjas.com"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
