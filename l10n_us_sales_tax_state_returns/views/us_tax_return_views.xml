<odoo>
    <record id="view_us_tax_return_form_state" model="ir.ui.view">
        <field name="name">us.tax.return.form.state.returns</field>
        <field name="model">us.tax.return</field>
        <field
            name="inherit_id"
            ref="l10n_us_sales_tax_report.view_us_tax_return_form"
        />
        <field name="arch" type="xml">
            <button name="action_export_worksheet" position="after">
                <field name="state_return_supported" invisible="1" />
                <button
                    name="action_export_state_return"
                    type="object"
                    string="Export State Return"
                    invisible="state == 'draft' or not state_return_supported"
                />
            </button>
        </field>
    </record>
</odoo>
