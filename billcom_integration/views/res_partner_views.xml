<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit Partner Form View -->
    <record id="view_partner_form_inherit_billcom" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.billcom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Add invisible fields for attrs usage -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="customer_rank" invisible="0" />
                <field name="supplier_rank" invisible="0" />
            </xpath>


            <!-- Add to Sales tab for customers -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page
                    name="billcom_id"
                    string="Bill.com Integration"
                    attrs="{'invisible': [('customer_rank', '=', 0), ('supplier_rank', '=', 0)]}"
                >
                    <group>
                        <field name="billcom_id" invisible="1" />
                        <field name="is_sync_to_billcom" />
                    </group>


                    <group attrs="{'invisible': [('is_sync_to_billcom', '=', False)]}">

                        <field name="billcom_sync_manual" widget="boolean_toggle" />
                        <field
                            name="billcom_res_currency_id"
                            options="{'no_create': True}"
                            groups="account.group_account_invoice"
                        />
                        <label
                            for="billcom_payment_purpose_id"
                            string="Payment Purpose"
                            class="mt16"
                            attrs="{'invisible': ['|', ('country_id', '=', False), ('billcom_id', '=', False)]}"
                        />
                        <div class="o_row">
                            <field
                                name="billcom_payment_purpose_id"
                                options="{'no_create': True}"
                                groups="account.group_account_invoice"
                                attrs="{'invisible': ['|', ('country_id', '=', False), ('billcom_id', '=', False)]}"
                            />
                            <button
                                name="action_fetch_payment_purposes"
                                type="object"
                                icon="fa-download"
                                class="btn-secondary"
                                attrs="{'invisible': ['|', ('country_id', '=', False), ('billcom_id', '=', False)]}"
                                help="Fetch available payment purposes from Bill.com based on country and currency"
                                groups="account.group_account_invoice"
                            />
                        </div>

                    </group>
                    <group attrs="{'invisible': [('is_sync_to_billcom', '=', False)]}">
                        <group
                            string="Vendor"
                            groups="account.group_account_invoice"
                            attrs="{'invisible': [('supplier_rank', '=', 0)]}"
                        >
                            <field
                                name="billcom_id"
                                attrs="{'readonly': [('billcom_sync_manual', '=', False)], 'invisible': [('billcom_id', '=', False),('billcom_sync_manual', '=', False)]}"
                            />
                            <field
                                name="last_sync_date"
                                readonly="1"
                                attrs="{'invisible': [('last_sync_date', '=', False)]}"
                            />
                            <field
                                name="billcom_sync_status"
                                readonly="1"
                                widget="badge"
                                decoration-success="billcom_sync_status == 'synced'"
                                decoration-danger="billcom_sync_status == 'sync_failed'"
                                decoration-info="billcom_sync_status == 'not_synced'"
                            />

                            <field
                                name="billcom_sync_error"
                                readonly="1"
                                attrs="{'invisible': [('billcom_sync_error', '=', False)]}"
                                widget="text"
                            />
                            <button
                                name="sync_to_billcom_vendor"
                                string="Sync as Vendor"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('is_sync_to_billcom', '=', False)]}"
                                groups="account.group_account_manager"
                            />

                        </group>
                        <group
                            string="Customer"
                            groups="account.group_account_invoice"
                            attrs="{'invisible': [('customer_rank', '=', 0)]}"
                        >

                            <field
                                name="billcom_id"
                                attrs="{'invisible': [('billcom_id', '=', False),('billcom_sync_manual', '=', False)]}"
                            />
                            <field
                                name="last_sync_date"
                                readonly="1"
                                attrs="{'invisible': [('last_sync_date', '=', False)]}"
                            />
                            <field
                                name="billcom_sync_status"
                                readonly="1"
                                widget="badge"
                                decoration-success="billcom_sync_status == 'synced'"
                                decoration-danger="billcom_sync_status == 'sync_failed'"
                                decoration-info="billcom_sync_status == 'not_synced'"
                            />
                            <field
                                name="billcom_sync_error"
                                readonly="1"
                                attrs="{'invisible': [('billcom_sync_error', '=', False)]}"
                                widget="text"
                            />
                            <button
                                name="sync_to_billcom_customer"
                                string="Sync as Customer"
                                type="object"
                                class="oe_highlight"
                                attrs="{'invisible': [('is_sync_to_billcom', '=', False)]}"
                                groups="account.group_account_manager"
                            />
                        </group>

                    </group>

                </page>

            </xpath>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_partner_filter_inherit_billcom" model="ir.ui.view">
        <field name="name">res.partner.filter.inherit.billcom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <filter name="supplier" position="after">
                <filter
                    string="Bill.com Sync Enabled"
                    name="billcom_sync"
                    domain="[('is_sync_to_billcom', '=', True)]"
                />
                <filter
                    string="Bill.com Linked"
                    name="billcom_linked"
                    domain="[('billcom', '!=', False)]"
                />
                <separator />
                <filter
                    string="Sync Failed"
                    name="sync_failed"
                    domain="[('billcom_sync_status', '=', 'sync_failed')]"
                />
                <filter
                    string="Synced to Bill.com"
                    name="synced"
                    domain="[('billcom_sync_status', '=', 'synced')]"
                />
            </filter>
            <group position="inside">
                <filter
                    string="Bill.com Status"
                    name="group_billcom_status"
                    context="{'group_by': 'is_sync_to_billcom'}"
                />
            </group>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_partner_tree_inherit_billcom" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.billcom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="is_sync_to_billcom" optional="show" />
                <field name="billcom_id" optional="hide" />
                <field name="last_sync_date" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
