<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_us_tax_import_wizard_form" model="ir.ui.view">
        <field name="name">us.tax.import.wizard.form</field>
        <field name="model">us.tax.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Tax Rates">
                <group>
                    <field name="source"/>
                    <field name="state_id"/>
                    <field name="effective_date"/>
                    <field name="file_data" filename="file_name" widget="binary"/>
                    <field name="file_name" invisible="1"/>
                    <field name="delimiter" invisible="source != 'generic_csv'"/>
                </group>
                <div invisible="not preview_html">
                    <h4>File Preview (first 5 rows)</h4>
                    <field name="preview_html"/>
                </div>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_us_tax_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Tax Rates</field>
        <field name="res_model">us.tax.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
