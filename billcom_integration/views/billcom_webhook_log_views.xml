<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Bill.com Webhook Log Tree View -->
    <record id="view_billcom_webhook_log_tree" model="ir.ui.view">
        <field name="name">billcom.webhook.log.tree</field>
        <field name="model">billcom.webhook.log</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="state=='success'"
                decoration-danger="state=='error'"
                decoration-info="state=='processing'"
            >
                <field name="create_date" string="Received At" />
                <field name="event_type" />
                <field name="entity_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state=='success'"
                    decoration-danger="state=='error'"
                    decoration-info="state=='processing'"
                    decoration-warning="state=='received'"
                />
                <field name="signature_valid" widget="boolean_toggle" />
                <field name="processed_at" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <!-- Bill.com Webhook Log Form View -->
    <record id="view_billcom_webhook_log_form" model="ir.ui.view">
        <field name="name">billcom.webhook.log.form</field>
        <field name="model">billcom.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="received,processing,success,error"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="idempotency_key" readonly="1" />
                            <field name="event_type" readonly="1" />
                            <field name="entity_id" readonly="1" />
                            <field name="signature_valid" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="create_date"
                                readonly="1"
                                string="Received At"
                            />
                            <field name="processed_at" readonly="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Webhook Data" name="webhook_data">
                            <field
                                name="webhook_data"
                                widget="ace"
                                options="{'mode': 'json'}"
                                readonly="1"
                            />
                        </page>
                        <page
                            string="Error Details"
                            name="error_details"
                            attrs="{'invisible': [('state', '!=', 'error')]}"
                        >
                            <field name="error_message" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bill.com Webhook Log Search View -->
    <record id="view_billcom_webhook_log_search" model="ir.ui.view">
        <field name="name">billcom.webhook.log.search</field>
        <field name="model">billcom.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="event_type" />
                <field name="entity_id" />
                <field name="idempotency_key" />
                <filter
                    string="Success"
                    name="success"
                    domain="[('state', '=', 'success')]"
                />
                <filter
                    string="Error"
                    name="error"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    string="Processing"
                    name="processing"
                    domain="[('state', '=', 'processing')]"
                />
                <filter
                    string="Received"
                    name="received"
                    domain="[('state', '=', 'received')]"
                />
                <separator />
                <filter
                    string="Valid Signature"
                    name="valid_signature"
                    domain="[('signature_valid', '=', True)]"
                />
                <filter
                    string="Invalid Signature"
                    name="invalid_signature"
                    domain="[('signature_valid', '=', False)]"
                />
                <separator />
                <filter
                    string="Today"
                    name="today"
                    domain="[('create_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"
                />
                <filter
                    string="Last 7 Days"
                    name="last_7_days"
                    domain="[('create_date', '&gt;=', (context_today()-datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Event Type"
                        name="group_event_type"
                        context="{'group_by': 'event_type'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                    <filter
                        string="Date"
                        name="group_date"
                        context="{'group_by': 'create_date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Bill.com Webhook Log Action -->
    <record id="action_billcom_webhook_log" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">billcom.webhook.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_last_7_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No webhook logs yet
            </p>
            <p>
                Webhook logs will appear here when Bill.com sends webhook notifications to Odoo.
            </p>
        </field>
    </record>


</odoo>
