<odoo>
    <record id="view_partner_form_us_tax_exemption" model="ir.ui.view">
        <field name="name">res.partner.form.us.tax.exemption</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(action_us_tax_exemption)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-certificate"
                    context="{'search_default_partner_id': id,
                                  'default_partner_id': id}"
                >
                    <field
                        name="us_tax_exemption_count"
                        widget="statinfo"
                        string="US Tax Exemptions"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
