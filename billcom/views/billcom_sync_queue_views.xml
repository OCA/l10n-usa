<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Bill.com Sync Queue Tree View -->
    <record id="view_billcom_sync_queue_tree" model="ir.ui.view">
        <field name="name">billcom.sync.queue.tree</field>
        <field name="model">billcom.sync.queue</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="state == 'success'"
                decoration-danger="state == 'error'"
                decoration-warning="state == 'queued'"
                decoration-info="state == 'processing'"
            >
                <field name="priority" widget="priority" />
                <field name="display_name" />
                <field name="sync_type" />
                <field name="direction" />
                <field name="operation" />
                <field name="state" />
                <field name="scheduled_date" />
                <field name="started_date" />
                <field name="completed_date" />
                <field name="retry_count" />
                <field name="record_name" />
                <field name="billcom_id" />
                <field name="user_id" />
                <field name="record_id" invisible="1" />
                <field name="record_model" invisible="1" />
                <button
                    name="action_process"
                    type="object"
                    string="Process"
                    attrs="{'invisible': [('state', 'not in', ['queued', 'error'])]}"
                    icon="fa-play"
                    class="btn-primary"
                />
                <button
                    name="action_retry"
                    type="object"
                    string="Retry"
                    attrs="{'invisible': [('state', '!=', 'error')]}"
                    icon="fa-refresh"
                    class="btn-warning"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="Cancel"
                    attrs="{'invisible': [('state', 'in', ['success', 'cancelled', 'processing'])]}"
                    icon="fa-times"
                    class="btn-secondary"
                />
                <button
                    name="action_view_record"
                    type="object"
                    string="View Record"
                    attrs="{'invisible': ['|', ('record_model', '=', False), ('record_id', '=', False)]}"
                    icon="fa-external-link"
                    class="btn-info"
                />
            </tree>
        </field>
    </record>

    <!-- Bill.com Sync Queue Form View -->
    <record id="view_billcom_sync_queue_form" model="ir.ui.view">
        <field name="name">billcom.sync.queue.form</field>
        <field name="model">billcom.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Bill.com Sync Queue Item">
                <header>
                    <button
                        name="action_process"
                        type="object"
                        string="Process"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', 'not in', ['draft', 'queued'])]}"
                    />
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        attrs="{'invisible': [('state', '!=', 'error')]}"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        attrs="{'invisible': [('state', 'in', ['success', 'cancelled', 'processing'])]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,queued,processing,success"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_record"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-external-link"
                            attrs="{'invisible': ['|', ('record_model', '=', False), ('record_id', '=', False)]}"
                            string="View Record"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Open</span>
                                <span class="o_stat_text">Record</span>
                            </div>
                        </button>
                        <button
                            name="action_view_logs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field string="Logs" name="logger_ids" widget="statinfo" />
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="display_name" />
                            <field name="sync_type" />
                            <field name="direction" />
                            <field name="operation" />
                            <field name="priority" widget="priority" />
                        </group>
                        <group>
                            <field name="record_model" />
                            <field name="record_id" />
                            <field name="record_name" />
                            <field name="billcom_id" />
                        </group>
                    </group>

                    <group string="Scheduling">
                        <group>
                            <field name="scheduled_date" />
                            <field name="started_date" />
                            <field name="completed_date" />
                        </group>
                        <group>
                            <field name="retry_count" />
                            <field name="max_retries" />
                            <field
                                name="next_retry_date"
                                attrs="{'invisible': [('retry_count', '=', 0)]}"
                            />
                        </group>
                    </group>

                    <group string="Context">
                        <group>
                            <field name="user_id" />
                            <field name="company_id" />
                        </group>
                    </group>

                    <notebook>
                        <page
                            string="Sync Data"
                            attrs="{'invisible': [('sync_data', '=', False)]}"
                        >
                            <field name="sync_data" nolabel="1" widget="text" />
                        </page>
                        <page
                            string="Response Data"
                            attrs="{'invisible': [('response_data', '=', False)]}"
                        >
                            <field name="response_data" nolabel="1" widget="text" />
                        </page>
                        <page
                            string="Error Details"
                            attrs="{'invisible': [('error_message', '=', False)]}"
                        >
                            <group>
                                <field name="error_message" nolabel="1" />
                            </group>
                            <group
                                string="Traceback"
                                attrs="{'invisible': [('error_traceback', '=', False)]}"
                            >
                                <field
                                    name="error_traceback"
                                    nolabel="1"
                                    widget="text"
                                />
                            </group>
                        </page>
                        <page string="Related Logs">
                            <field name="logger_ids" nolabel="1">
                                <tree>
                                    <field name="create_date" />
                                    <field name="level" />
                                    <field name="status" />
                                    <field name="message" />
                                    <field name="duration" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bill.com Sync Queue Search View -->
    <record id="view_billcom_sync_queue_search" model="ir.ui.view">
        <field name="name">billcom.sync.queue.search</field>
        <field name="model">billcom.sync.queue</field>
        <field name="arch" type="xml">
            <search string="Bill.com Sync Queue">
                <field name="display_name" />
                <field name="record_name" />
                <field name="billcom_id" />
                <field name="user_id" />

                <filter
                    string="Queued"
                    name="filter_queued"
                    domain="[('state', '=', 'queued')]"
                />
                <filter
                    string="Processing"
                    name="filter_processing"
                    domain="[('state', '=', 'processing')]"
                />
                <filter
                    string="Success"
                    name="filter_success"
                    domain="[('state', '=', 'success')]"
                />
                <filter
                    string="Errors"
                    name="filter_error"
                    domain="[('state', '=', 'error')]"
                />

                <separator />
                <filter
                    string="High Priority"
                    name="filter_high_priority"
                    domain="[('priority', 'in', ['2', '3'])]"
                />
                <filter
                    string="Need Retry"
                    name="filter_retry"
                    domain="[('state', '=', 'error'), ('retry_count', '&lt;', 'max_retries')]"
                />

                <separator />
                <filter
                    string="Today"
                    name="filter_today"
                    domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="This Week"
                    name="filter_week"
                    domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />

                <group expand="0" string="Group By">
                    <filter
                        string="Sync Type"
                        name="group_sync_type"
                        context="{'group_by': 'sync_type'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Direction"
                        name="group_direction"
                        context="{'group_by': 'direction'}"
                    />
                    <filter
                        string="Priority"
                        name="group_priority"
                        context="{'group_by': 'priority'}"
                    />
                    <filter
                        string="User"
                        name="group_user"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        string="Date"
                        name="group_date"
                        context="{'group_by': 'create_date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Bill.com Sync Queue Action -->
    <record id="action_billcom_sync_queue" model="ir.actions.act_window">
        <field name="name">Bill.com Sync Queue</field>
        <field name="res_model">billcom.sync.queue</field>
        <field name="view_mode">tree,form</field>
        <field
            name="context"
        >{'search_default_filter_queued': 1, 'search_default_filter_processing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sync queue items found
            </p>
            <p>
                Synchronization items will appear here when operations are queued for processing.
            </p>
        </field>
    </record>

    <!-- Cron Job for Processing Queue -->
    <record id="ir_cron_process_sync_queue" model="ir.cron">
        <field name="name">Bill.com: Process Sync Queue</field>
        <field name="model_id" ref="model_billcom_sync_queue" />
        <field name="state">code</field>
        <field name="code">model.process_queue()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
