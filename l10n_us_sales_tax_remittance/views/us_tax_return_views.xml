<odoo>
    <record id="view_us_tax_return_form_remittance" model="ir.ui.view">
        <field name="name">us.tax.return.form.remittance</field>
        <field name="model">us.tax.return</field>
        <field
            name="inherit_id"
            ref="l10n_us_sales_tax_report.view_us_tax_return_form"
        />
        <field name="arch" type="xml">
            <button name="action_file" position="after">
                <button
                    name="action_create_remittance"
                    type="object"
                    string="Create Remittance"
                    class="oe_highlight"
                    invisible="state not in ('generated', 'filed') or move_id"
                />
            </button>
            <div name="button_box" position="inside">
                <button
                    name="action_view_remittance"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not move_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Remittance Bill</span>
                    </div>
                </button>
            </div>
            <field name="line_ids" position="before">
                <field name="move_id" invisible="1" />
                <group>
                    <group string="Remittance">
                        <field name="authority_id" />
                        <field name="collection_allowance" />
                        <field name="net_tax_due" />
                        <field name="remitted_date" invisible="not remitted_date" />
                    </group>
                    <group string="GL Tie-Out">
                        <field name="tax_collected_gl" />
                        <field name="tie_out_variance" />
                    </group>
                </group>
            </field>
        </field>
    </record>
</odoo>
