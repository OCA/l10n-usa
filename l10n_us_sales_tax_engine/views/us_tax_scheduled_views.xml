<odoo>
    <!-- Future-dated rates/rules activate automatically on their effective date
         (calc-time date filtering); these views let admins see what's staged. -->
    <record id="action_us_tax_rate_upcoming" model="ir.actions.act_window">
        <field name="name">Upcoming Rate Changes</field>
        <field name="res_model">us.tax.rate</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('effective_date', '>=', context_today().strftime('%Y-%m-%d'))]</field>
    </record>

    <record id="action_us_tax_rule_upcoming" model="ir.actions.act_window">
        <field name="name">Upcoming Taxability Changes</field>
        <field name="res_model">us.tax.rule</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('effective_date', '>=', context_today().strftime('%Y-%m-%d'))]</field>
    </record>
</odoo>
