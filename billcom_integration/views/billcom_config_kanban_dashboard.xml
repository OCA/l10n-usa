<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Bill.com Configuration Kanban Dashboard View -->
    <record id="billcom_config_kanban_dashboard" model="ir.ui.view">
        <field name="name">billcom.config.kanban.dashboard</field>
        <field name="model">billcom.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_billcom_kanban" create="false">
                <field name="name" />
                <field name="state" />
                <field name="environment" />
                <field name="company_id" />
                <field name="color" />
                <field name="kanban_dashboard" />
                <field name="last_connection_test" />
                <field name="last_sync_date" />
                <field name="auto_sync_enabled" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click o_kanban_dashboard_card"
                            style="max-width: 98vw; margin: 0 auto; box-shadow: 0 8px 32px rgba(255,90,10,0.15); border: 1px solid rgba(255,90,10,0.1); border-radius: 12px;"
                        >
                            <t
                                t-set="dashboard"
                                t-value="JSON.parse(record.kanban_dashboard.raw_value)"
                            />

                            <!-- Enhanced Header -->
                            <div
                                class="o_kanban_card_header"
                                style="background: linear-gradient(135deg, #ff5a0a 0%, #875a7b 100%); color: white; padding: 20px; border-radius: 8px 8px 0 0;"
                            >
                                <div
                                    class="d-flex justify-content-between align-items-center"
                                >
                                    <div>
                                        <div
                                            class="o_primary"
                                            style="font-size: 22px; font-weight: bold;"
                                        >
                                            <i
                                                class="fa fa-cloud mr-3"
                                                style="color: #f0f0f0;"
                                            />
                                            <field name="name" />
                                        </div>
                                        <div
                                            class="o_secondary mt-2"
                                            style="opacity: 0.9;"
                                        >
                                            <span
                                                class="badge px-3 py-2"
                                                t-attf-style="background-color: #{record.state.raw_value == 'connected' ? '#28a745' : (record.state.raw_value == 'error' ? '#dc3545' : '#6c757d')}; color: white; font-size: 13px; border-radius: 15px;"
                                            >
                                                <i class="fa fa-circle mr-1" />
                                                <t t-esc="record.state.value" />
                                            </span>
                                            <span
                                                class="ml-3"
                                                style="font-size: 13px; background: rgba(255,255,255,0.15); padding: 6px 12px; border-radius: 12px;"
                                            >
                                                <i class="fa fa-server mr-1" />
                                                <t t-esc="record.environment.value" />
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <div
                                            style="font-size: 32px; opacity: 0.7; color: #f0f0f0;"
                                        >
                                            <i class="fa fa-exchange" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Main Content -->
                            <div
                                class="o_kanban_card_content"
                                style="padding: 25px; background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);"
                            >

                                <!-- Quick Action Buttons -->
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <div
                                            class="d-flex justify-content-center"
                                            style="gap: 15px; flex-wrap: wrap;"
                                        >
                                            <button
                                                class="btn px-4 py-2"
                                                style="background: #ff5a0a; border: none; color: white; border-radius: 25px; min-width: 130px; font-weight: 600; font-size: 13px; box-shadow: 0 4px 12px rgba(255,90,10,0.4); transition: all 0.3s ease;"
                                                onmouseover="this.style.background='#e54e09'; this.style.transform='translateY(-2px)'"
                                                onmouseout="this.style.background='#ff5a0a'; this.style.transform='translateY(0)'"
                                            >
                                                <i
                                                    class="fa fa-refresh mr-2"
                                                /> Sync Now
                                            </button>
                                            <button
                                                class="btn px-4 py-2"
                                                name="test_connection"
                                                type="object"
                                                style="background: transparent; border: 2px solid #875a7b; color: #875a7b; border-radius: 25px; min-width: 130px; font-weight: 600; font-size: 13px; transition: all 0.3s ease;"
                                                onmouseover="this.style.background='#875a7b'; this.style.color='white'"
                                                onmouseout="this.style.background='transparent'; this.style.color='#875a7b'"
                                            >
                                                <i class="fa fa-plug mr-2" /> Test API
                                            </button>
                                            <button
                                                class="btn px-4 py-2"
                                                name="action_refresh_dashboard"
                                                type="object"
                                                style="background: transparent; border: 2px solid #17a2b8; color: #17a2b8; border-radius: 25px; min-width: 130px; font-weight: 600; font-size: 13px; transition: all 0.3s ease;"
                                                onmouseover="this.style.background='#17a2b8'; this.style.color='white'"
                                                onmouseout="this.style.background='transparent'; this.style.color='#17a2b8'"
                                            >
                                                <i class="fa fa-sync mr-2" /> Refresh
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Main Metrics Grid -->
                                <div class="row mb-4">
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a
                                            name="action_open_partners"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card h-100"
                                                style="border: none; box-shadow: 0 6px 20px rgba(255,90,10,0.15); border-radius: 15px; border-left: 5px solid #ff5a0a; transition: all 0.3s ease; cursor: pointer; background: white;"
                                                onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(255,90,10,0.25)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(255,90,10,0.15)'"
                                            >
                                                <div class="card-body p-4">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div style="flex: 1;">
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 14px;"
                                                            >
                                                                <i
                                                                    class="fa fa-users mr-2"
                                                                    style="color: #ff5a0a;"
                                                                />
                                                                Partners
                                                            </h6>
                                                            <h3
                                                                class="mb-2"
                                                                style="font-weight: 700; font-size: 28px; color: #ff5a0a;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['total_partners']"
                                                                />
                                                            </h3>
                                                            <div
                                                                style="display: flex; gap: 6px; flex-wrap: wrap;"
                                                            >
                                                                <span
                                                                    class="badge px-2 py-1"
                                                                    style="font-size: 10px; border-radius: 8px; background: #28a745; color: white;"
                                                                >
                                                                    <t
                                                                        t-esc="dashboard['synced_vendors']"
                                                                    /> Vendors
                                                                </span>
                                                                <span
                                                                    class="badge px-2 py-1"
                                                                    style="font-size: 10px; border-radius: 8px; background: #875a7b; color: white;"
                                                                >
                                                                    <t
                                                                        t-esc="dashboard['synced_customers']"
                                                                    /> Customers
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div
                                                            style="font-size: 32px; opacity: 0.2; color: #ff5a0a;"
                                                        >
                                                            <i class="fa fa-users" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a
                                            name="action_open_bills"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card h-100"
                                                style="border: none; box-shadow: 0 6px 20px rgba(135,90,123,0.15); border-radius: 15px; border-left: 5px solid #875a7b; transition: all 0.3s ease; cursor: pointer; background: white;"
                                                onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(135,90,123,0.25)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(135,90,123,0.15)'"
                                            >
                                                <div class="card-body p-4">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div style="flex: 1;">
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 14px;"
                                                            >
                                                                <i
                                                                    class="fa fa-file-text mr-2"
                                                                    style="color: #875a7b;"
                                                                />
                                                                Bills
                                                            </h6>
                                                            <h3
                                                                class="mb-2"
                                                                style="font-weight: 700; font-size: 28px; color: #875a7b;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['total_bills']"
                                                                />
                                                            </h3>
                                                            <span
                                                                class="badge px-2 py-1"
                                                                style="font-size: 10px; border-radius: 8px; background: #28a745; color: white;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['synced_bills']"
                                                                /> Synced
                                                            </span>
                                                        </div>
                                                        <div
                                                            style="font-size: 32px; opacity: 0.2; color: #875a7b;"
                                                        >
                                                            <i
                                                                class="fa fa-file-text"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a
                                            name="action_open_payments"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card h-100"
                                                style="border: none; box-shadow: 0 6px 20px rgba(23,162,184,0.15); border-radius: 15px; border-left: 5px solid #17a2b8; transition: all 0.3s ease; cursor: pointer; background: white;"
                                                onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(23,162,184,0.25)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(23,162,184,0.15)'"
                                            >
                                                <div class="card-body p-4">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div style="flex: 1;">
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 14px;"
                                                            >
                                                                <i
                                                                    class="fa fa-credit-card mr-2"
                                                                    style="color: #17a2b8;"
                                                                />
                                                                Payments
                                                            </h6>
                                                            <h3
                                                                class="mb-2"
                                                                style="font-weight: 700; font-size: 28px; color: #17a2b8;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['total_payments']"
                                                                />
                                                            </h3>
                                                            <span
                                                                class="badge px-2 py-1"
                                                                style="font-size: 10px; border-radius: 8px; background: #28a745; color: white;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['synced_payments']"
                                                                /> Synced
                                                            </span>
                                                        </div>
                                                        <div
                                                            style="font-size: 32px; opacity: 0.2; color: #17a2b8;"
                                                        >
                                                            <i
                                                                class="fa fa-credit-card"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>

                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a
                                            name="action_open_invoices"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card h-100"
                                                style="border: none; box-shadow: 0 6px 20px rgba(40,167,69,0.15); border-radius: 15px; border-left: 5px solid #28a745; transition: all 0.3s ease; cursor: pointer; background: white;"
                                                onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 30px rgba(40,167,69,0.25)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(40,167,69,0.15)'"
                                            >
                                                <div class="card-body p-4">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div style="flex: 1;">
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 14px;"
                                                            >
                                                                <i
                                                                    class="fa fa-file-invoice mr-2"
                                                                    style="color: #28a745;"
                                                                />
                                                                Invoices
                                                            </h6>
                                                            <h3
                                                                class="mb-2"
                                                                style="font-weight: 700; font-size: 28px; color: #28a745;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['total_invoices']"
                                                                />
                                                            </h3>
                                                            <span
                                                                class="badge px-2 py-1"
                                                                style="font-size: 10px; border-radius: 8px; background: #28a745; color: white;"
                                                            >
                                                                <t
                                                                    t-esc="dashboard['synced_invoices']"
                                                                /> Synced
                                                            </span>
                                                        </div>
                                                        <div
                                                            style="font-size: 32px; opacity: 0.2; color: #28a745;"
                                                        >
                                                            <i
                                                                class="fa fa-file-invoice"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>

                                <!-- Sync Queue Status -->
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <a
                                            name="action_open_sync_queue"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card"
                                                style="border: none; box-shadow: 0 4px 15px rgba(255,90,10,0.1); border-radius: 12px; background: linear-gradient(135deg, #fff8f3 0%, #ffffff 100%); border-left: 4px solid #ff5a0a; transition: all 0.3s ease;"
                                                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(255,90,10,0.15)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(255,90,10,0.1)'"
                                            >
                                                <div class="card-body p-3">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div>
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 15px;"
                                                            >
                                                                <i
                                                                    class="fa fa-list-alt mr-2"
                                                                    style="color: #ff5a0a;"
                                                                />
                                                                Sync Queue Status
                                                            </h6>
                                                            <div
                                                                style="display: flex; gap: 10px; flex-wrap: wrap;"
                                                            >
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #28a745; color: white;"
                                                                    t-if="dashboard['queue_completed'] > 0"
                                                                >
                                                                    <i
                                                                        class="fa fa-check mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['queue_completed']"
                                                                    /> Completed
                                                                </span>
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #ffc107; color: #333;"
                                                                    t-if="dashboard['queue_pending'] > 0"
                                                                >
                                                                    <i
                                                                        class="fa fa-clock-o mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['queue_pending']"
                                                                    /> Pending
                                                                </span>
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #dc3545; color: white;"
                                                                    t-if="dashboard['queue_failed'] > 0"
                                                                >
                                                                    <i
                                                                        class="fa fa-times mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['queue_failed']"
                                                                    /> Failed
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div
                                                            style="font-size: 24px; opacity: 0.3; color: #ff5a0a;"
                                                        >
                                                            <i class="fa fa-list-alt" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>

                                <!-- Activity Summary -->
                                <div class="row">
                                    <div class="col-12">
                                        <a
                                            name="action_open_logs"
                                            type="object"
                                            class="text-decoration-none"
                                        >
                                            <div
                                                class="card"
                                                style="border: none; box-shadow: 0 4px 15px rgba(255,90,10,0.1); border-radius: 12px; background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); border-left: 4px solid #ff5a0a; transition: all 0.3s ease;"
                                                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(255,90,10,0.15)'"
                                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(255,90,10,0.1)'"
                                            >
                                                <div class="card-body p-3">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center"
                                                    >
                                                        <div>
                                                            <h6
                                                                class="text-dark mb-2"
                                                                style="font-weight: 600; font-size: 15px;"
                                                            >
                                                                <i
                                                                    class="fa fa-chart-line mr-2"
                                                                    style="color: #ff5a0a;"
                                                                />
                                                                Today's Activity
                                                            </h6>
                                                            <div
                                                                style="display: flex; gap: 10px; flex-wrap: wrap;"
                                                            >
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #ff5a0a; color: white;"
                                                                >
                                                                    <i
                                                                        class="fa fa-file-text mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['log_today']"
                                                                    /> Logs
                                                                </span>
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #ffc107; color: #333;"
                                                                    t-if="dashboard['log_warnings_today'] > 0"
                                                                >
                                                                    <i
                                                                        class="fa fa-exclamation-triangle mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['log_warnings_today']"
                                                                    /> Warnings
                                                                </span>
                                                                <span
                                                                    class="badge px-3 py-1"
                                                                    style="font-size: 11px; border-radius: 10px; background: #dc3545; color: white;"
                                                                    t-if="dashboard['log_errors_today'] > 0"
                                                                >
                                                                    <i
                                                                        class="fa fa-times-circle mr-1"
                                                                    />
                                                                    <t
                                                                        t-esc="dashboard['log_errors_today']"
                                                                    /> Errors
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div
                                                            style="font-size: 24px; opacity: 0.3; color: #ff5a0a;"
                                                        >
                                                            <i
                                                                class="fa fa-chart-line"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_billcom_dashboard" model="ir.actions.act_window">
        <field name="name">Bill.com Dashboard</field>
        <field name="res_model">billcom.config</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="billcom_config_kanban_dashboard" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Bill.com configuration!
            </p>
            <p>
                Configure your connection to Bill.com API to start synchronizing
                vendors, bills, and payments between Odoo and Bill.com.
            </p>
        </field>
    </record>

</odoo>
